{
    "name": "ithilbert/laravel-kit",
    "type": "library",
    "license": "MIT",
    "description": "Tools für das Programmieren mit Laravel",
    "keywords": [
        "it-hilbert",
        "laravel"
    ],
    "authors": [
        {
            "name": "Jörg Hilbert",
            "homepage": "https://www.it-hilbert.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://www.it-hilbert.com",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "ITHilbert\\LaravelKit\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "ITHilbert\\LaravelKit\\LaravelKitServiceProvider"
            ],
            "aliases": {
                "HButton": "ITHilbert\\LaravelKit\\Helpers\\HButton",
                "HForm": "ITHilbert\\LaravelKit\\Helpers\\HForm",
                "DataTableScript": "ITHilbert\\LaravelKit\\Helpers\\DataTableScript"
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "ITHilbert\\LaravelKit\\Tests\\": "tests/"
        }
    }
}
